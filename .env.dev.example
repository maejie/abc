# Copy to .env for local development.

NODE_ENV=development
PORT=4000
HTTPS=false

# Set to /abc to serve the app under http://localhost:5173/abc/.
APP_BASE_PATH=/
VITE_APP_BASE_PATH=/

# Local-only passwordless user-name login.
ALLOW_PASSWORDLESS_AUTH=true
VITE_ALLOW_PASSWORDLESS_AUTH=true

# Optional Google login for local testing.
VITE_GOOGLE_CLIENT_ID=

