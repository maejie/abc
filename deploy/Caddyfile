# The Caddyfile is an easy way to configure your Caddy web server.
#
# maejie.com uses automatic HTTPS. Ensure the domain's A/AAAA DNS records
# point to this machine's public IP.

maejie.com {
	log {
		output file /var/log/caddy/access.log
		format console
	}

	encode gzip zstd

	route {
		redir /abc /abc/

		# Backend JSON API.
		handle /abc/api/* {
			reverse_proxy 127.0.0.1:4000
		}

		# Remote MCP endpoint. This must be before the /abc/* static SPA route.
		handle /abc/mcp {
			reverse_proxy 127.0.0.1:4000
		}

		# App-relative OAuth protected resource metadata.
		handle /abc/.well-known/oauth-protected-resource* {
			reverse_proxy 127.0.0.1:4000
		}

		# RFC 9728 derives protected resource metadata by inserting
		# /.well-known/oauth-protected-resource before the resource path.
		# For https://maejie.com/abc/mcp, clients may request:
		#   /.well-known/oauth-protected-resource/abc/mcp
		handle /.well-known/oauth-protected-resource* {
			rewrite * /abc/.well-known/oauth-protected-resource
			reverse_proxy 127.0.0.1:4000
		}

		# Frontend SPA. Keep this after API/MCP/well-known routes.
		handle_path /abc/* {
			root * /var/www/abc
			try_files {path} /index.html
			file_server
		}

		handle {
			respond 404
		}
	}
}
