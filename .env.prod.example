# Copy to .env on the production host and fill in real values.

NODE_ENV=production
PORT=4000
HTTPS=false

# Public route prefix. Use / for domain root, or /abc for a subpath deployment.
APP_BASE_PATH=/abc
VITE_APP_BASE_PATH=/abc

# Keep passwordless auth disabled for public production traffic.
ALLOW_PASSWORDLESS_AUTH=false
VITE_ALLOW_PASSWORDLESS_AUTH=false

# Required for browser Google sign-in.
VITE_GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com

# Caddy / Let's Encrypt deployment settings.
BUDGET_DOMAIN=example.com
BUDGET_BASE_PATH=/abc
ACME_EMAIL=admin@example.com
BACKEND_UPSTREAM=localhost:4000
FRONTEND_DIST=/var/www/abc
PM2_APP_NAME=budget-backend

# Direct Node HTTPS mode, only if not using Caddy.
# HTTPS=true
# TLS_CERT_FILE=/etc/letsencrypt/live/example.com/fullchain.pem
# TLS_KEY_FILE=/etc/letsencrypt/live/example.com/privkey.pem
